{
  "name": "agent-outbox",
  "version": "0.1.0",
  "description": "A review-and-approve outbox that lets AI agents draft iMessages and contact changes, and sends them from your Mac only after you approve with Touch ID.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ay2609/agent-outbox"
  },
  "type": "module",
  "bin": {
    "outbox": "src/cli/index.ts"
  },
  "scripts": {
    "server": "bun run src/server.ts",
    "mcp": "bun run src/mcp/index.ts",
    "cli": "bun run src/cli/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.17",
    "libphonenumber-js": "1.13.15",
    "papaparse": "5.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
