<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- outboxd: the Bun server (agent API on a unix socket, dashboard on 127.0.0.1). It cannot send messages.
     This is a template: install.sh fills in the double-underscore placeholders below (XML-escaped; the state
     directory contains a space, which is fine inside a plist string). Do not load it by hand. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.ay2609.agent-outbox</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BUN__</string>
		<string>run</string>
		<string>src/server.ts</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>OUTBOX_HOME</key>
		<string>__STATE__</string>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__STATE__/logs/outboxd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__STATE__/logs/outboxd.err.log</string>
</dict>
</plist>
